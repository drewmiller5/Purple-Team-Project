# Shared secret authenticating target's /internal/* defensive endpoints
# against blue_agent and the Wazuh active-response scripts. No default --
# the stack refuses to start without it. Generate a real value, e.g.:
#   openssl rand -hex 32
INTERNAL_ACTION_TOKEN=

# Optional: Ollama model tag for red_agent/blue_agent. Defaults to qwen2.5:7b.
# OLLAMA_MODEL=qwen2.5:7b

# Password for the dashboard's HTTP Basic Auth (username is hardcoded as
# "operator" in dashboard/app.py). No default -- the stack refuses to start
# without it. Generate a real value, e.g.:
#   openssl rand -hex 32
DASHBOARD_AUTH_TOKEN=
