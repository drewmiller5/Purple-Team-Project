# Shared secret authenticating target's /internal/* defensive endpoints
# against blue_agent and the Wazuh active-response scripts. No default --
# the stack refuses to start without it. Generate a real value, e.g.:
#   openssl rand -hex 32
INTERNAL_ACTION_TOKEN=

# H54: round_helper's own dedicated secret for its container-restart
# control plane (docker.sock access), distinct from INTERNAL_ACTION_TOKEN
# above -- target is considered compromised-by-design (deliberately
# RCE-able), so a stolen copy of its token must not also unlock this. No
# default -- the stack refuses to start without it. Generate a real value,
# e.g.:
#   openssl rand -hex 32
ROUND_HELPER_TOKEN=

# Optional: Ollama model tag for red_agent/blue_agent. Defaults to qwen2.5:7b.
# OLLAMA_MODEL=qwen2.5:7b

# Optional: set to false to run a round with red/blue blind to their
# recorded memory (red_memory.json/blue_memory.json) -- recall_past_findings
# returns nothing, but nothing is deleted and new findings still get
# recorded. Comparison/demo flag. Defaults to true.
# MEMORY_ENABLED=true

# Password for the dashboard's HTTP Basic Auth (username is hardcoded as
# "operator" in dashboard/app.py). No default -- the stack refuses to start
# without it. Generate a real value, e.g.:
#   openssl rand -hex 32
DASHBOARD_AUTH_TOKEN=

# H55: DASHBOARD_AUTH_TOKEN above only proves "may view this dashboard" --
# firing a red action, firing a blue action, and starting a round (which
# reaches round_helper's docker.sock-backed container-restart control
# plane) are 3 separate privilege domains, each gated by its own token in
# addition to DASHBOARD_AUTH_TOKEN. Generate real, distinct values, e.g.:
#   openssl rand -hex 32
DASHBOARD_RED_ACTION_TOKEN=
DASHBOARD_BLUE_ACTION_TOKEN=
DASHBOARD_INFRA_ACTION_TOKEN=

# Task 8 (H7/H48): Wazuh indexer/API/dashboard credentials. All three
# replace the old hardcoded upstream demo values (SecretPassword,
# kibanaserver) -- no defaults, the stack refuses to start without them.
#
# WAZUH_INDEXER_PASSWORD is the OpenSearch "admin" user's password. It is
# used by wazuh.manager, wazuh.dashboard, AND wazuh/config/wazuh_indexer/
# internal_users.yml's "admin" entry -- if you rotate it, you MUST also
# regenerate that entry's bcrypt hash and all three must agree, or the
# indexer will reject every caller. Generate the password and hash with:
#   openssl rand -hex 24
#   docker run --rm -e JAVA_HOME=/usr/share/wazuh-indexer/jdk \
#     --entrypoint /usr/share/wazuh-indexer/plugins/opensearch-security/tools/hash.sh \
#     wazuh/wazuh-indexer:4.9.2 -p '<your new password>'
# then paste the resulting $2y$... hash into internal_users.yml's admin.hash.
WAZUH_INDEXER_PASSWORD=

# WAZUH_DASHBOARD_PASSWORD is the "kibanaserver" service-account password
# the dashboard backend uses to authenticate to the indexer. Same
# regeneration process as above, but for internal_users.yml's
# kibanaserver.hash entry.
WAZUH_DASHBOARD_PASSWORD=

# WAZUH_API_PASSWORD is the wazuh-wui user's password for wazuh.manager's
# own REST API (not the indexer -- no internal_users.yml hash needed here,
# the manager image creates/updates this user itself from the env var on
# startup). Must satisfy the manager's complexity rule: 8+ chars including
# at least one uppercase, one lowercase, one digit, and one of @$!%*?&-_.
# Generate e.g.:
#   openssl rand -hex 24  # then add a class-satisfying prefix/suffix
#
# Fix round (finding #2): also consumed automatically by
# wazuh.dashboard's entrypoint wrapper (wazuh_dashboard_entrypoint.sh),
# which templates it into wazuh.yml at container start -- no manual edit
# of wazuh/config/wazuh_dashboard/wazuh.yml is needed when this value
# changes, just restart the wazuh.dashboard container.
WAZUH_API_PASSWORD=
